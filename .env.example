# ---- Clerk (auth) ---- create an app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---- Supabase (database) ---- create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# ---- Vision (floor-plan reading) ----
# Preferred: Google Gemini free tier — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
# Optional: override the Gemini model (default gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
# Alternative: Anthropic Claude (paid) — used only if GEMINI_API_KEY is not set
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=
