# ---- Clerk (auth) ---- create an app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---- Supabase (database) ---- create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# ---- Vision (floor-plan reading) ---- Anthropic API key from https://console.anthropic.com
# Without this, plan upload still works but you enter the kitchen run manually.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: override the vision model
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
